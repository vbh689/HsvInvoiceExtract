# ---- Mode ----
MOCK_MODE=false                     # true = canned fixtures, no API key, no network
APP_TIMEZONE=Asia/Ho_Chi_Minh       # day boundaries for "today"/"this month" stats

# ---- The one model ----
# Any OpenAI-compatible Chat Completions endpoint. Two worked examples below —
# uncomment one. Nothing in the code is provider-specific.
#
# --- Option A: Google Gemini (OpenAI-compatible layer) ---
#   Get a key at https://aistudio.google.com/apikey — the Flash-Lite models
#   below have a free tier, so the service can be trialled end-to-end at zero
#   cost before any billing is set up.
#   Note the TRAILING SLASH on the base URL — required.
#   Gemini does NOT report cost, so cost is computed from the rates below
#   (cost_source='computed'). ALWAYS change the two rates when you change
#   LLM_MODEL — a stale pair silently skews every cost figure in the dashboard.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=123
#
#   Rate card (USD per 1M tokens, input / output):
#     gemini-3.5-flash-lite   0.30 / 2.50   current, best quality of the Lite tier
#     gemini-3.1-flash-lite   0.25 / 1.50   cheaper, still current
#     gemini-2.5-flash-lite   0.10 / 0.40   cheapest, but Google retires it 2026-10-16
#
LLM_MODEL=gemini-3.5-flash-lite
LLM_PRICE_PER_1M_INPUT=0.30
LLM_PRICE_PER_1M_OUTPUT=2.50
#
# LLM_MODEL=gemini-3.1-flash-lite
# LLM_PRICE_PER_1M_INPUT=0.25
# LLM_PRICE_PER_1M_OUTPUT=1.50
#
# LLM_MODEL=gemini-2.5-flash-lite
# LLM_PRICE_PER_1M_INPUT=0.10
# LLM_PRICE_PER_1M_OUTPUT=0.40
#
# --- Option B: OpenRouter (one key, any provider; reports real billed cost) ---
#   Model slugs are namespaced: <provider>/<model>.
#   Reports usage.cost automatically → cost_source='provider', no config drift.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=google/gemini-3.1-flash-lite
# LLM_PRICE_PER_1M_INPUT=0.25      # fallback only; provider cost wins
# LLM_PRICE_PER_1M_OUTPUT=1.50
# OPENROUTER_SITE_URL=https://invoices.internal      # optional attribution
# OPENROUTER_SITE_NAME=HSV Invoice Extraction        # optional attribution

LLM_TIMEOUT_S=25
LLM_SUPPORTS_STRUCTURED_OUTPUT=true # send response_format json_schema
LLM_RETRY_ON_FAILURE=true           # one retry, same model, on malformed/empty/timeout

# ---- Prompt ----
PROMPT_FILE=prompts/extract_v2.txt
PROMPT_VERSION=extract_v2           # folded into the cache key; bump to bust cache
SCHEMA_VERSION=v2                   # folded into the cache key

# ---- Storage ----
DATABASE_PATH=data/app.db
CACHE_ENABLED=true                  # toggle extraction caching on/off entirely
CACHE_TTL_DAYS=1                    # 24h expiry; 0 = never expires

# ---- Currency ----
USD_TO_VND_RATE=26500                # TEMPORARY fixed rate, not live FX

# ---- Upload limits ----
MAX_UPLOAD_BYTES=5242880            # 5 MB
NORMALIZE_MAX_DIMENSION=2048
NORMALIZE_JPEG_QUALITY=85
PDF_RENDER_DPI=200

# ---- Validation tolerances ----
TOLERANCE_RELATIVE=0.005            # 0.5%
TOLERANCE_ABSOLUTE_FLOOR_VND=1
LINE_MISMATCH_RATIO_TRIGGER=0.2     # share of arithmetic-mismatched lines that raises LINE_ARITHMETIC_MISMATCH_MULTI
CONFIDENCE_WEIGHT_ERROR=0.25
CONFIDENCE_WEIGHT_WARNING=0.08
CONFIDENCE_WEIGHT_INFO=0.0
STATUS_THRESHOLD_USABLE=0.75
STATUS_THRESHOLD_REVIEW=0.35

# ---- Dashboard ----
DASHBOARD_PASSWORD=123              # no default — login fails until it's set
SESSION_SECRET_KEY=                 # unset = random per process, sessions reset on restart

# ---- Server ----
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
