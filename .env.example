# ---- Mode ----
MOCK_MODE=false                     # true = canned fixtures, no API key, no network
APP_TIMEZONE=Asia/Ho_Chi_Minh       # day boundaries for "today"/"this month" stats
EXPOSE_USAGE_IN_RESPONSE=true       # false = omit `usage` from /v1/extract responses (still logged in the audit trail)

# ---- Models ----
# Numbered slots, LLM_MODEL_<N> / _PRICE_IN / _PRICE_OUT, N = 1, 2, 3, ...
# (no cap). LLM_MODEL_1 is the DEFAULT model, used when a request doesn't
# specify X-Model (API) or leaves the dashboard dropdown at its default.
# _BASE_URL / _API_KEY / _REASONING_EFFORT are optional per-model overrides
# -- omit them to inherit the shared LLM_BASE_URL / LLM_API_KEY /
# LLM_REASONING_EFFORT below. Set them to point a specific model at a
# different provider, or to change its reasoning effort, without affecting
# the others. Keep the <N> matching its own slot: a stray LLM_MODEL_3_* line
# under the slot-1 block configures model 3, silently.

# Shared endpoint/key (used by any slot that doesn't set its own override):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=123

# Model 1: Gemini, via the shared endpoint.
# This is the default model. Gemini does NOT report cost,
# cost is computed from the rates
LLM_MODEL_1=gemini-3.6-flash
LLM_MODEL_1_PRICE_IN=1.50
LLM_MODEL_1_PRICE_OUT=7.50
#LLM_MODEL_1_BASE_URL=https://openrouter.ai/api/v1
#LLM_MODEL_1_API_KEY=123
LLM_MODEL_1_REASONING_EFFORT=low

# Model 2 alternative: OpenRouter, reports real cost
LLM_MODEL_2=google/gemini-3.5-flash
LLM_MODEL_2_PRICE_IN=1.50
LLM_MODEL_2_PRICE_OUT=9.00
LLM_MODEL_2_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_2_API_KEY=123
LLM_MODEL_2_REASONING_EFFORT=low     # OpenRouter accepts "low" as a top-level reasoning_effort field

# Model 3: OpenAI direct
LLM_MODEL_3=gpt-5.6-terra
LLM_MODEL_3_PRICE_IN=2.50
LLM_MODEL_3_PRICE_OUT=15.00
LLM_MODEL_3_BASE_URL=https://api.openai.com/v1
LLM_MODEL_3_API_KEY=sk-123
LLM_MODEL_3_REASONING_EFFORT=low

# Model 4: Anthropic direct, via Claude's OpenAI-compatible endpoint
LLM_MODEL_4=claude-haiku-4.5
LLM_MODEL_4_PRICE_IN=1.00
LLM_MODEL_4_PRICE_OUT=5.00
LLM_MODEL_4_BASE_URL=https://api.anthropic.com/v1/
LLM_MODEL_4_API_KEY=sk-ant-123
LLM_MODEL_4_REASONING_EFFORT=off    # compat layer takes thinking via extra_body, not reasoning_effort

# Model 5: OpenAI direct
LLM_MODEL_5=gpt-5.6-luna
LLM_MODEL_5_PRICE_IN=1.00
LLM_MODEL_5_PRICE_OUT=6.00
LLM_MODEL_5_BASE_URL=https://api.openai.com/v1
LLM_MODEL_5_API_KEY=sk-123
LLM_MODEL_5_REASONING_EFFORT=low

LLM_TIMEOUT_S=25
LLM_SUPPORTS_STRUCTURED_OUTPUT=true # send response_format json_schema
LLM_RETRY_ON_FAILURE=true           # one retry, same model, on malformed/empty/timeout
LLM_REASONING_EFFORT=low            # low across all providers; "off" = omit the param

# ---- Prompt ----
PROMPT_FILE=prompts/extract_v2.txt
PROMPT_VERSION=extract_v2           # folded into the cache key; bump to bust cache
SCHEMA_VERSION=v2                   # folded into the cache key

# ---- Storage ----
DATABASE_PATH=data/app.db
CACHE_ENABLED=true                  # toggle extraction caching on/off entirely
CACHE_TTL_DAYS=1                    # 24h expiry; 0 = never expires

# ---- Currency ----
USD_TO_VND_RATE=26500                # TEMPORARY fixed rate, not live FX

# ---- Upload limits ----
MAX_UPLOAD_BYTES=5242880            # 5 MB
NORMALIZE_MAX_DIMENSION=2048
NORMALIZE_JPEG_QUALITY=85
PDF_RENDER_DPI=200

# ---- Validation tolerances ----
TOLERANCE_RELATIVE=0.005            # 0.5%
TOLERANCE_ABSOLUTE_FLOOR_VND=1
LINE_MISMATCH_RATIO_TRIGGER=0.2     # share of arithmetic-mismatched lines that raises LINE_ARITHMETIC_MISMATCH_MULTI
CONFIDENCE_WEIGHT_ERROR=0.25
CONFIDENCE_WEIGHT_WARNING=0.08
CONFIDENCE_WEIGHT_INFO=0.0
STATUS_THRESHOLD_USABLE=0.75
STATUS_THRESHOLD_REVIEW=0.35

# ---- Auth ----
API_KEY_REQUIRED=false                # false = /v1/extract skips X-API-Key checking entirely (api_key_id logs as NULL)

# ---- Dashboard ----
DASHBOARD_PASSWORD=123              # no default — login fails until it's set
SESSION_SECRET_KEY=                 # unset = random per process, sessions reset on restart

# ---- Server ----
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
